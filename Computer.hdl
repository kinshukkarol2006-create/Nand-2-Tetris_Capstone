// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: Computer.hdl
/**
 * The Hack computer, consisting of CPU, ROM, and RAM.
 * When reset == 0, the program stored in ROM executes.
 * When reset == 1, the program restarts from the beginning.
 * Thus, to start running the currently loaded program,
 * set reset to 1, and then set it to 0.
 * From this point onward, the user is at the mercy of the software.
 * Depending on the program and its correctness, the screen may
 * display output, the user may be expected to enter input using
 * the keyboard, or, in general, the program may do whatever it is
 * designed to do.
 */
CHIP Computer {

    IN reset;

    PARTS:
   // Instruction memory (ROM) outputs current instruction at address pc
    ROM32K(address=pc, out=instruction);

    // Hack CPU executes instruction using memory input inM and control/status signals
    CPU(
        inM=inM,
        instruction=instruction,
        reset=reset,
        outM=outM,
        writeM=writeM,
        addressM=addressM,
        pc=pc
    );

    // Data memory (RAM + Screen + Keyboard) wired to CPU outputs
    Memory(
        in=outM,
        load=writeM,
        address=addressM,
        out=inM
    );
}